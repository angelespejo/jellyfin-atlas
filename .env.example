# ---------------------------------------------------------------------------
# JellyFin Atlas - sample environment file
#
# 1. Copy this file to `.env` (same folder as package.json).
# 2. Fill in the values below.
# 3. Start the app: `pnpm dev-remote` (development) or `pnpm build` + `node build`.
#
# These values are read at runtime: changing them only requires a restart, not
# a rebuild.
#
# Do you just want to try the app or develop the UI? Run `pnpm dev` instead:
# it serves a bundled demo library and never contacts Jellyfin.
#
# `.env` is git-ignored, so your real key never reaches the repository.
# ---------------------------------------------------------------------------

# Base URL of your Jellyfin server, including the port and without a trailing
# slash. It must be reachable from the machine running JellyFin Atlas.
# Examples:
#   http://localhost:8096
#   http://192.168.1.10:8096
#   https://jellyfin.example.com
JELLYFIN_URL=http://localhost:8096

# Optional. Browser-facing URL used for 'Watch in Jellyfin' deep links. Set this
# when JELLYFIN_URL is only reachable from the server/container (for example
# http://jellyfin:8096 in Docker). Defaults to JELLYFIN_URL.
# JELLYFIN_PUBLIC_URL=https://jellyfin.example.com

# API key used by the server to read your library. Create one in Jellyfin:
# Dashboard -> Administration -> API Keys -> "+" (Administration may be under
# "Advanced" in older versions). Give it a clear name (for example
# "JellyFin Atlas") and paste the value here.
# Treat it like a password: it grants full access to your Jellyfin server.
JELLYFIN_API_KEY=your-jellyfin-api-key

# Optional. Jellyfin user whose watch state (watched, favorite, continue
# watching) is shown. If omitted, the first user returned by Jellyfin is used.
# List the available ids with:
#   curl -H "Authorization: MediaBrowser Token=YOUR_API_KEY" \
#     http://your-server:8096/Users
# JELLYFIN_USER_ID=

# Optional. Set to true to serve the bundled demo library instead of a real
# Jellyfin server (useful for a container demo). `pnpm dev` already does this.
# JELLYFIN_MOCK=true

# Optional. Port used by the production server (`node build`). Defaults to 3000.
# Ignored by `pnpm dev` / `pnpm dev-remote`, which always use port 5143.
# PORT=3000
